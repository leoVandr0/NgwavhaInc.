# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_PATH=./uploads

# ML Recommendation Engine
ML_ENGINE_URL=http://localhost:8000

# SFU (self-hosted mediasoup WebRTC server) — used for live lessons.
# The API calls this URL only for admin lifecycle events (e.g. closing a room
# when a LiveSession is ended/deleted). Auth is a JWT signed with JWT_SECRET
# above, so both servers must share that secret. Leave empty in dev if you
# aren't running the SFU; admin calls become no-ops.
SFU_URL=http://localhost:4000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Cloudinary (Optional - for cloud storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
