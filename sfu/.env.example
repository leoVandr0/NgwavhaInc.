# --- Ngwavha SFU configuration ---

# TCP port that serves HTTP health + Socket.IO signaling.
SFU_PORT=4000

# MUST match the main API server's JWT_SECRET (server/.env) so the SFU can
# verify the same tokens the browser already holds in localStorage.
JWT_SECRET=replace-with-the-same-secret-as-the-api-server

# Frontend origin(s) allowed to connect (comma-separated). Use your deployed app
# URL in production, e.g. https://app.ngwavha.com
CLIENT_URL=http://localhost:5173

# Public IPv4 of THIS VPS — the address browsers must reach for media.
# Leave empty for local two-browser testing on one machine.
ANNOUNCED_IP=

# Interface mediasoup binds to (0.0.0.0 = all interfaces). Usually leave as-is.
SFU_LISTEN_IP=0.0.0.0

# UDP/TCP media port range. Open these on the VPS firewall / security group.
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100

# Number of mediasoup workers (≈ one per CPU core in production).
SFU_NUM_WORKERS=1

# mediasoup worker log level: debug | warn | error | none
SFU_LOG_LEVEL=warn
